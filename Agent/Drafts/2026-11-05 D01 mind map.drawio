        <mxCell id="title" value="D01 Handheld gripper body: real Dex1-1 or printed copy" style="text;html=1;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="36" as="geometry"/></mxCell>
        <mxCell id="sub" value="Draft 2026-11-05. Hover a node for its detail and source; change them with Edit Data (Ctrl/Cmd+M). Dashed outline = open item; dotted line = connection. Sources: msc-thesis-vault and msc-thesis as of 2026-11-05; vault PR #21 was open." style="text;html=1;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5d6875;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="900" height="40" as="geometry"/></mxCell>
        <UserObject id="n0" label="D01 Handheld gripper body" tooltip="What does the operator hold, so that handheld and robot camera images match? Accepted 2026-10-19 as the printed copy (approved proposal); reopened at the supervisor meeting on 2026-11-03 with the real Dex1-1 as the alternative.&#10;&#10;Source: Decisions/D01; msc-thesis docs/proposal.md §1; Daily 2026-11-03" detail="What does the operator hold, so that handheld and robot camera images match? Accepted 2026-10-19 as the printed copy (approved proposal); reopened at the supervisor meeting on 2026-11-03 with the real Dex1-1 as the alternative." source="Decisions/D01; msc-thesis docs/proposal.md §1; Daily 2026-11-03" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#243447;strokeColor=#243447;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1011.9" y="633.0" width="339.4" height="58" as="geometry"/></mxCell></UserObject>
        <UserObject id="n1" label="Real Dex1-1 · main line" tooltip="The delivered gripper is held on the PICO controller; the controller trigger drives it over RS-485 from the recording PC.&#10;&#10;Source: D01 History 2026-11-04/05; Dex1-1 technical note 2026-11-03" detail="The delivered gripper is held on the PICO controller; the controller trigger drives it over RS-485 from the recording PC." source="D01 History 2026-11-04/05; Dex1-1 technical note 2026-11-03" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1403.1" y="558.0" width="248.6" height="42" as="geometry"/></mxCell></UserObject>
        <UserObject id="n2" label="Idea" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="295.0" width="90.7" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n3" label="Trigger → PC → RS-485 → gripper" tooltip="PICO trigger → recording PC → rt/dex1/&lt;side&gt;/cmd → dex1_1_service → USB → RS-485-to-USB board → gripper. Proportional or binary mapping is a software choice; both to be tested.&#10;&#10;Source: Technical note (dex1_1_service ced3216, xr_teleoperate 817fb00); Unitree support page §4" detail="PICO trigger → recording PC → rt/dex1/&lt;side&gt;/cmd → dex1_1_service → USB → RS-485-to-USB board → gripper. Proportional or binary mapping is a software choice; both to be tested." source="Technical note (dex1_1_service ced3216, xr_teleoperate 817fb00); Unitree support page §4" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="230.0" width="284.5" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n4" label="real-adapter bow to the sleeve" tooltip="ActiveUMI-style bow from the gripper rear to a boss under the sleeve front half, 2 × M3 into heat-set inserts; sleeve variants stay swappable.&#10;&#10;Source: D10 Decision and History 2026-11-04; zeng2025" detail="ActiveUMI-style bow from the gripper rear to a boss under the sleeve front half, 2 × M3 into heat-set inserts; sleeve variants stay swappable." source="D10 Decision and History 2026-11-04; zeng2025" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="274.0" width="261.0" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n5" label="Second gripper stays on UR10e" tooltip="Two grippers are ordered (one pair). One is the handheld, the other stays on the robot, so the robot remains available.&#10;&#10;Source: D01 History 2026-11-04" detail="Two grippers are ordered (one pair). One is the handheld, the other stays on the robot, so the robot remains available." source="D01 History 2026-11-04" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="318.0" width="264.3" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n6" label="Precedent: ActiveUMI, RAPID" tooltip="ActiveUMI puts a motorised gripper on the VR controller. RAPID uses one device for both the handheld and the robot role.&#10;&#10;Source: zeng2025 Sec. 3.1; RAPID arXiv 2602.06653 (as cited in D01 Options)" detail="ActiveUMI puts a motorised gripper on the VR controller. RAPID uses one device for both the handheld and the robot role." source="zeng2025 Sec. 3.1; RAPID arXiv 2602.06653 (as cited in D01 Options)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="362.0" width="255.4" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n7" label="Gripper signal" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="439.0" width="157.9" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n8" label="Command + width + tau_est" tooltip="State q, dq and tau_est at 500 Hz (the product page says 1000 Hz). No force/torque sensor; grip force only from tau_est after calibration against a force gauge.&#10;&#10;Source: Technical note, Software path (2000 µs RecurrentThread)" detail="State q, dq and tau_est at 500 Hz (the product page says 1000 Hz). No force/torque sensor; grip force only from tau_est after calibration against a force gauge." source="Technical note, Software path (2000 µs RecurrentThread)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="418.0" width="243.0" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n9" label="rad → width curve" tooltip="Position is in rad and the sources disagree on the scale (5.4 rad vs 5.62 rad over the stroke). Measure the curve on the delivered gripper.&#10;&#10;Source: Technical note, Position scale; D09 row" detail="Position is in rad and the sources disagree on the scale (5.4 rad vs 5.62 rad over the stroke). Measure the curve on the delivered gripper." source="Technical note, Position scale; D09 row" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2042.1" y="462.0" width="178.1" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n10" label="Mass and tether" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="561.0" width="171.4" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n11" label="≈ 846 g without cables" tooltip="550 g gripper + 63.5 g real-adapter + 31.8 g sleeve A + ≈ 201 g controller with batteries. Printed parts at 1.27 g/cm³ PETG (assumed), 100 % infill. Unverified until weighed. For scale: UMI 780 g, UMI-3D 1120 g.&#10;&#10;Source: D01 side-by-side 2026-11-05; Unitree product page; VR Expert listing; chi2024, wang2026 via trigger survey" detail="550 g gripper + 63.5 g real-adapter + 31.8 g sleeve A + ≈ 201 g controller with batteries. Printed parts at 1.27 g/cm³ PETG (assumed), 100 % infill. Unverified until weighed. For scale: UMI 780 g, UMI-3D 1120 g." source="D01 side-by-side 2026-11-05; Unitree product page; VR Expert listing; chi2024, wang2026 via trigger survey" status="unverified"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="518.0" width="206.1" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n12" label="24–64 V, 3.5 A peak" tooltip="24–64 V DC, 0.03 A static, 3.5 A peak (≈ 84 W at 24 V, computed). No supply in the box. Grip force 5–120 N set through kp.&#10;&#10;Source: Unitree product page; US Robot Store (reseller)" detail="24–64 V DC, 0.03 A static, 3.5 A peak (≈ 84 W at 24 V, computed). No supply in the box. Grip force 5–120 N set through kp." source="Unitree product page; US Robot Store (reseller)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="562.0" width="189.3" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n13" label="USB + XT30 power/RS-485 cable" tooltip="Cables to the handheld: camera USB plus one XT30 2+2 cable carrying power and RS-485. Cable length unverified.&#10;&#10;Source: Technical note, Wiring" detail="Cables to the handheld: camera USB plus one XT30 2+2 cable carrying power and RS-485. Cable length unverified." source="Technical note, Wiring" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="606.0" width="276.6" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n14" label="Before delivery" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="683.0" width="165.8" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n15" label="Dummy gripper print" tooltip="Print the gripper from the official STEP to check fit, balance and LED visibility in hand.&#10;&#10;Source: D01 History 2026-11-05 (vault PR #21)" detail="Print the gripper from the official STEP to check fit, balance and LED visibility in hand." source="D01 History 2026-11-05 (vault PR #21)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="662.0" width="194.9" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n16" label="Software against a mock" tooltip="Trigger → rt/dex1/&lt;side&gt;/cmd pipeline developed against a mock gripper, so it is ready when the gripper arrives.&#10;&#10;Source: D01 History 2026-11-05 (vault PR #21)" detail="Trigger → rt/dex1/&lt;side&gt;/cmd pipeline developed against a mock gripper, so it is ready when the gripper arrives." source="D01 History 2026-11-05 (vault PR #21)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2042.1" y="706.0" width="220.6" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n17" label="Open" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="827.0" width="96.3" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n18" label="Delivery date" tooltip="Unknown; the supervisor does not know either.&#10;&#10;Source: Daily 2026-11-04" detail="Unknown; the supervisor does not know either." source="Daily 2026-11-04" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2042.1" y="762.0" width="143.4" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n19" label="RS-485 check" tooltip="The PC commands the gripper at the needed rate; supply, cable and mass acceptable on a tethered handheld.&#10;&#10;Source: Waiting.md, Dex1-1 delivery" detail="The PC commands the gripper at the needed rate; supply, cable and mass acceptable on a tethered handheld." source="Waiting.md, Dex1-1 delivery" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2042.1" y="806.0" width="147.8" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n20" label="Proportional vs binary trigger" tooltip="Test both mappings on the gripper; also PICO trigger value vs travel through XRoboToolkit and trigger-to-finger latency.&#10;&#10;Source: Waiting.md, Dex1-1 delivery and PICO setup" detail="Test both mappings on the gripper; also PICO trigger value vs travel through XRoboToolkit and trigger-to-finger latency." source="Waiting.md, Dex1-1 delivery and PICO setup" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2042.1" y="850.0" width="252.0" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n21" label="Cable clip, UR10e 24 V supply" tooltip="The cable clip waits on where the cables leave the gripper. Can the UR10e tool connector supply 24 V at 3.5 A peak for the robot-side gripper?&#10;&#10;Source: Waiting.md, Dex1-1 delivery" detail="The cable clip waits on where the cables leave the gripper. Can the UR10e tool connector supply 24 V at 3.5 A peak for the robot-side gripper?" source="Waiting.md, Dex1-1 delivery" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2042.1" y="894.0" width="255.4" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n22" label="Recommendation" tooltip="Real Dex1-1 as the main line; printed copy frozen as the documented fallback. The supervisor decides; the approved proposal still names the printed copy.&#10;&#10;Source: Martyn 2026-11-05 (D01 History, vault PR #21); Waiting.md" detail="Real Dex1-1 as the main line; printed copy frozen as the documented fallback. The supervisor decides; the approved proposal still names the printed copy." source="Martyn 2026-11-05 (D01 History, vault PR #21); Waiting.md" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1403.1" y="1012.0" width="205.0" height="42" as="geometry"/></mxCell></UserObject>
        <UserObject id="n23" label="Main line: real Dex1-1" tooltip="Work before delivery goes into the real path: dummy-gripper print and software pipeline.&#10;&#10;Source: D01 History 2026-11-05 (vault PR #21)" detail="Work before delivery goes into the real path: dummy-gripper print and software pipeline." source="D01 History 2026-11-05 (vault PR #21)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="971.0" width="212.8" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n24" label="Fallback: printed copy, frozen" tooltip="The copy stays at its current CAD state (link A modelled, bracket not started) as the documented fallback.&#10;&#10;Source: D01 History 2026-11-05 (vault PR #21)" detail="The copy stays at its current CAD state (link A modelled, bracket not started) as the documented fallback." source="D01 History 2026-11-05 (vault PR #21)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="1015.0" width="265.4" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n25" label="Switch if delivery slips or RS-485 fails" tooltip="Proposed decision rule: real Dex1-1 if the RS-485 check passes, otherwise the printed copy.&#10;&#10;Source: Waiting.md, Supervisor" detail="Proposed decision rule: real Dex1-1 if the RS-485 check passes, otherwise the printed copy." source="Waiting.md, Supervisor" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1689.1" y="1059.0" width="323.7" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n26" label="Printed copy · fallback" tooltip="A printed passive copy of the Dex1-1 mechanism, closed by a squeeze trigger; no motor or power on the handheld.&#10;&#10;Source: D01 Decision; D10" detail="A printed passive copy of the Dex1-1 mechanism, closed by a squeeze trigger; no motor or power on the handheld." source="D01 Decision; D10" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="718.2" y="425.0" width="241.9" height="42" as="geometry"/></mxCell></UserObject>
        <UserObject id="n27" label="Idea" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="569.4" y="173.0" width="90.7" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n28" label="Rack-and-pinion on MGN9 rails" tooltip="Copy of the Dex1-1 mechanism, rebuilt from the official STEP solids: MGN9C blocks fixed, rails moving, one central 20-tooth pinion.&#10;&#10;Source: D10 Decision; official STEP" detail="Copy of the Dex1-1 mechanism, rebuilt from the official STEP solids: MGN9C blocks fixed, rails moving, one central 20-tooth pinion." source="D10 Decision; official STEP" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="156.8" y="130.0" width="264.3" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n29" label="Squeeze trigger, link ≈ 4:1" tooltip="Multi-finger squeeze trigger recessed in the sleeve front, about 10 mm travel (unverified), rigid link to one carriage (about 4:1). Spring return, optional continuous lock.&#10;&#10;Source: D10 Decision incl. vault PR #21 changes" detail="Multi-finger squeeze trigger recessed in the sleeve front, about 10 mm travel (unverified), rigid link to one carriage (about 4:1). Spring return, optional continuous lock." source="D10 Decision incl. vault PR #21 changes" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="192.6" y="174.0" width="228.5" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n30" label="Precedent: UMI, RDT2, TacUMI" tooltip="UMI and RDT2 use a printed copy of the robot gripper; UMI and UMI-3D use a printed linkage; TacUMI rejected a ratchet lock for a continuous one.&#10;&#10;Source: chi2024; liu2026; wang2026; cheng2026 Sec. III-A, IV-B; transmission survey 2026-11-05" detail="UMI and RDT2 use a printed copy of the robot gripper; UMI and UMI-3D use a printed linkage; TacUMI rejected a ratchet lock for a continuous one." source="chi2024; liu2026; wang2026; cheng2026 Sec. III-A, IV-B; transmission survey 2026-11-05" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="157.9" y="218.0" width="263.2" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n31" label="Gripper signal" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="502.2" y="295.0" width="157.9" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n32" label="Achieved width only" tooltip="No command and no force signal. Width needs a mapping from the sensor to the fingertips.&#10;&#10;Source: D01 side-by-side; D05" detail="No command and no force signal. Width needs a mapping from the sensor to the fingertips." source="D01 side-by-side; D05" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230.7" y="274.0" width="190.4" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n33" label="ArUco (offline) or AS5600 (online)" tooltip="ArUco markers in the camera image give width offline; an AS5600 encoder on the pinion shaft gives it online.&#10;&#10;Source: msc-thesis docs/proposal.md §5" detail="ArUco markers in the camera image give width offline; an AS5600 encoder on the pinion shaft gives it online." source="msc-thesis docs/proposal.md §5" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140.0" y="318.0" width="281.1" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n34" label="Mass and tether" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="488.8" y="417.0" width="171.4" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n35" label="≈ 438 g + unmodelled parts" tooltip="Steel 108.6 g (2 MGN9C + 2 rails) + printed 66.0 g mechanism + 9.1 g trigger and link + 21.5 g camera + 31.8 g sleeve A + ≈ 201 g controller. Bracket, pivot mounts, spring, pins and lock not modelled, so the total will rise. Unverified until weighed.&#10;&#10;Source: D01 side-by-side incl. vault PR #21 (Fusion, PETG 1.27 g/cm³ assumed)" detail="Steel 108.6 g (2 MGN9C + 2 rails) + printed 66.0 g mechanism + 9.1 g trigger and link + 21.5 g camera + 31.8 g sleeve A + ≈ 201 g controller. Bracket, pivot mounts, spring, pins and lock not modelled, so the total will rise. Unverified until weighed." source="D01 side-by-side incl. vault PR #21 (Fusion, PETG 1.27 g/cm³ assumed)" status="unverified"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="182.6" y="374.0" width="238.6" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n36" label="Camera USB only, no power" tooltip="Unpowered handheld; camera USB plus the encoder USB if the online width signal is used. The robot keeps its gripper.&#10;&#10;Source: D01 side-by-side; D01 Options" detail="Unpowered handheld; camera USB plus the encoder USB if the online width signal is used. The robot keeps its gripper." source="D01 side-by-side; D01 Options" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180.3" y="418.0" width="240.8" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n37" label="Printed fingers" tooltip="Same outer geometry, but printed fingers grip differently from the alloy jaws.&#10;&#10;Source: D01 Options" detail="Same outer geometry, but printed fingers grip differently from the alloy jaws." source="D01 Options" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="266.6" y="462.0" width="154.6" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n38" label="Before delivery" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="494.4" y="539.0" width="165.8" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n39" label="Testable once printed" tooltip="Works without the delivered gripper; needs printer access and the MGN9 parts.&#10;&#10;Source: D01 side-by-side; Waiting.md, Printer access" detail="Works without the delivered gripper; needs printer access and the MGN9 parts." source="D01 side-by-side; Waiting.md, Printer access" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220.6" y="518.0" width="200.5" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n40" label="CAD frozen" tooltip="copy-trigger v5, copy-transmission-A v1, copy-sleeve-front v1, ASM copy-path v11. Cable-and-drum transmission parked (drum radius about 2 mm, below the 2.5 mm pinion bore; computed).&#10;&#10;Source: Fusion &quot;Dex1-1 Handheld&quot; 2026-11-05; D10 History (vault PR #21)" detail="copy-trigger v5, copy-transmission-A v1, copy-sleeve-front v1, ASM copy-path v11. Cable-and-drum transmission parked (drum radius about 2 mm, below the 2.5 mm pinion bore; computed)." source="Fusion &quot;Dex1-1 Handheld&quot; 2026-11-05; D10 History (vault PR #21)" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="291.2" y="562.0" width="129.9" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n41" label="Open" tooltip="" detail="" source="" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="563.8" y="683.0" width="96.3" height="36" as="geometry"/></mxCell></UserObject>
        <UserObject id="n42" label="Gripper bracket (empty)" tooltip="grip-to-gripper-bracket, which joins the copy to the sleeve, is still empty.&#10;&#10;Source: Fusion; D01 side-by-side" detail="grip-to-gripper-bracket, which joins the copy to the sleeve, is still empty." source="Fusion; D01 side-by-side" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c2f;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="205.0" y="618.0" width="216.2" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n43" label="Pivots, spring, pins, lock" tooltip="Not modelled. Squeeze travel and force to be measured on the first print.&#10;&#10;Source: D01 side-by-side; PRINT-TEST-QUEUE.md" detail="Not modelled. Squeeze travel and force to be measured on the first print." source="D01 side-by-side; PRINT-TEST-QUEUE.md" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c2f;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="202.7" y="662.0" width="218.4" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n44" label="57 mm grip-span limit" tooltip="Controller-as-grip sets a floor: sleeve A is 56.9 mm across. With the recessed blade the span is about 54–64 mm, against an optimum of 45–55 mm; the squeeze trigger can only add to it. At 4:1, staying under the 50–60 N repetitive grip figure limits the carriage-side force to about 12–15 N (computed). Operator hand size unknown.&#10;&#10;Source: Fusion ASM copy-path v9; Lee et al. 2009 and ILO Encyclopaedia, both not in bib; vault PR #21" detail="Controller-as-grip sets a floor: sleeve A is 56.9 mm across. With the recessed blade the span is about 54–64 mm, against an optimum of 45–55 mm; the squeeze trigger can only add to it. At 4:1, staying under the 50–60 N repetitive grip figure limits the carriage-side force to about 12–15 N (computed). Operator hand size unknown." source="Fusion ASM copy-path v9; Lee et al. 2009 and ILO Encyclopaedia, both not in bib; vault PR #21" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c2f;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="217.3" y="706.0" width="203.8" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n45" label="MGN9 purchase on hold" tooltip="2 MGN9C blocks and 2 MGN9 rails (75 mm), on hold until D01 is settled.&#10;&#10;Source: D10 History 2026-11-04; Waiting.md" detail="2 MGN9C blocks and 2 MGN9 rails (75 mm), on hold until D01 is settled." source="D10 History 2026-11-04; Waiting.md" status="open"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c2f;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="206.1" y="750.0" width="215.0" height="34" as="geometry"/></mxCell></UserObject>
        <UserObject id="n46" label="Shared and open for both" tooltip="What both paths have in common, what is open for both, and what D01 does not decide.&#10;&#10;Source: D01 side-by-side; Daily 2026-11-05" detail="What both paths have in common, what is open for both, and what D01 does not decide." source="D01 side-by-side; Daily 2026-11-05" status=""><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f2c230;strokeColor=#f2c230;fontColor=#2a2410;fontFamily=Helvetica;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="695.8" y="1001.0" width="264.3" height="42" as="geometry"/></mxCell></UserObject>
