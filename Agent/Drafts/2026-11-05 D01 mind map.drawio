  <diagram id="d01-mind-map" name="D01 mind map">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2486" pageHeight="1100" math="0" shadow="0">
