        <UserObject label="Command + position + torque" tooltip="Commanded position, measured position and torque estimate at 500 Hz in Unitree&#x27;s gripper service (the product page states 1000 Hz). No force sensor; grip force only from the torque estimate after calibration.&#xa;&#xa;Source: Unitree dex1_1_service; Unitree product page" detail="Commanded position, measured position and torque estimate at 500 Hz in Unitree&#x27;s gripper service (the product page states 1000 Hz). No force sensor; grip force only from the torque estimate after calibration." source="Unitree dex1_1_service; Unitree product page" status="" link="https://github.com/unitreerobotics/dex1_1_service" id="n8">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2042.1" y="418" width="243" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Angle → width curve" tooltip="Position is reported as a motor angle, and Unitree&#x27;s code uses two scales (5.62 rad and 5.4 rad over the stroke). The curve is measured on the delivered gripper.&#xa;&#xa;Source: Unitree dex1_1_service; Unitree xr_teleoperate" detail="Position is reported as a motor angle, and Unitree&#x27;s code uses two scales (5.62 rad and 5.4 rad over the stroke). The curve is measured on the delivered gripper." source="Unitree dex1_1_service; Unitree xr_teleoperate" status="open" link="https://github.com/unitreerobotics/xr_teleoperate" id="n9">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" parent="1" vertex="1">
            <mxGeometry x="2042.1" y="467" width="178.1" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Mass and tether" tooltip="" detail="" source="" status="" id="n10">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="1760" y="640" width="171.4" height="39" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div&gt;Gripper 550 g + printed adapter 64 g&lt;/div&gt;&lt;div&gt;+ grip sleeve 32 g + controller ≈ 201 g&lt;/div&gt;&lt;div&gt;≈ 846 g (without cables)&lt;/div&gt;" tooltip="550 g gripper (product page) + 64 g adapter + 32 g sleeve (CAD estimates, PETG, 100 % infill) + ≈ 201 g controller (155 g retailer listing plus batteries, estimated). Not weighed. For scale: UMI 780 g (Chi et al., 2024), UMI-3D 1120 g (Wang, 2026).&#xa;&#xa;Source: Unitree product page; VR Expert listing; arXiv:2402.10329; arXiv:2604.14089" detail="550 g gripper (product page) + 64 g adapter + 32 g sleeve (CAD estimates, PETG, 100 % infill) + ≈ 201 g controller (155 g retailer listing plus batteries, estimated). Not weighed. For scale: UMI 780 g (Chi et al., 2024), UMI-3D 1120 g (Wang, 2026)." source="Unitree product page; VR Expert listing; arXiv:2402.10329; arXiv:2604.14089" status="unverified" link="https://unitree.com/Dex1-1" id="n11">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2045.3999999999999" y="530" width="389.2" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Power: 24–64 V, 3.5 A peak" tooltip="24–64 V DC, 0.03 A static, 3.5 A peak (≈ 84 W at 24 V, computed). No supply in the box. Grip force 5–120 N, set by the controller.&#xa;&#xa;Source: Unitree product page" detail="24–64 V DC, 0.03 A static, 3.5 A peak (≈ 84 W at 24 V, computed). No supply in the box. Grip force 5–120 N, set by the controller." source="Unitree product page" status="" link="https://unitree.com/Dex1-1" id="n12">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
