        <UserObject label="Printed copy · fallback" tooltip="A passive, 3D-printed copy of the Dex1-1 finger mechanism, closed by hand; no motor or power on the handheld.&#xa;&#xa;Source: Original proposal" detail="A passive, 3D-printed copy of the Dex1-1 finger mechanism, closed by hand; no motor or power on the handheld." source="Original proposal" status="" id="n26">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=15;" parent="1" vertex="1">
