        <mxCell id="title" value="Handheld Gripper Body: Real Dex1-1 vs Printed Copy" style="text;html=1;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Status 5 November 2026. Hover a node for its detail and source; click a node with a link to open its public source. Dashed outline = open item; dotted line = connection. Values from manufacturer documentation and CAD estimates; nothing weighed or tested yet. Full details and references in the accompanying brief." style="text;html=1;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5d6875;" parent="1" vertex="1">
          <mxGeometry x="40" y="58" width="900" height="40" as="geometry" />
        </mxCell>
        <UserObject label="Handheld gripper body" tooltip="What does the operator hold, so that handheld and robot camera images match? The original proposal names a printed copy; the real gripper is now proposed as the main line.&#xa;&#xa;Source: Original proposal" detail="What does the operator hold, so that handheld and robot camera images match? The original proposal names a printed copy; the real gripper is now proposed as the main line." source="Original proposal" status="" id="n0">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#243447;strokeColor=#243447;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=22;" parent="1" vertex="1">
            <mxGeometry x="1011.9" y="633" width="339.4" height="58" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Real Dex1-1 · main line" tooltip="One of the two ordered grippers is held on the PICO controller; the controller trigger drives it over RS-485 from the recording PC.&#xa;&#xa;Source: Unitree developer docs" detail="One of the two ordered grippers is held on the PICO controller; the controller trigger drives it over RS-485 from the recording PC." source="Unitree developer docs" status="" link="https://support.unitree.com/home/en/dex1-1_gripper/about_dex1_1" id="n1">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=15;" parent="1" vertex="1">
            <mxGeometry x="1415.1" y="558" width="248.6" height="42" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Idea" tooltip="" detail="" source="" status="" id="n2">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="1772" y="295" width="90.7" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Trigger → PC → RS-485 → gripper" tooltip="PICO trigger → recording PC → Unitree gripper service → USB → RS-485-to-USB adapter → gripper. Proportional or open/close mapping is a software choice; both are tested.&#xa;&#xa;Source: Unitree developer docs; Unitree dex1_1_service" detail="PICO trigger → recording PC → Unitree gripper service → USB → RS-485-to-USB adapter → gripper. Proportional or open/close mapping is a software choice; both are tested." source="Unitree developer docs; Unitree dex1_1_service" status="" link="https://github.com/unitreerobotics/dex1_1_service" id="n3">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2025.1" y="209" width="284.5" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Printed adapter to the grip" tooltip="Printed bow from the gripper rear to a boss under the grip sleeve, fixed with 2 × M3 screws into heat-set inserts (CAD, not built).&#xa;&#xa;Source: CAD design" detail="Printed bow from the gripper rear to a boss under the grip sleeve, fixed with 2 × M3 screws into heat-set inserts (CAD, not built)." source="CAD design" status="" id="n4">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2025.1" y="253" width="261" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="One gripper validates the concept" tooltip="One of the two ordered grippers becomes the handheld. One gripper is enough to validate the concept: trigger, command, gripper signal, power and communication. The number of grippers needed on the robot depends on the deployment robot, which is not yet decided.&#xa;&#xa;Source: Accompanying brief" detail="One of the two ordered grippers becomes the handheld. One gripper is enough to validate the concept: trigger, command, gripper signal, power and communication. The number of grippers needed on the robot depends on the deployment robot, which is not yet decided." source="Accompanying brief" status="" id="n5">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2025.1" y="297" width="264.3" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="References: ActiveUMI, RAPID" tooltip="ActiveUMI mounts a motorised gripper on the VR controller (Zeng et al., 2025). RAPID uses one device for both the handheld and the robot role (Yin et al., 2026).&#xa;&#xa;Source: Zeng et al., 2025, arXiv:2510.01607; Yin et al., 2026, arXiv:2602.06653" detail="ActiveUMI mounts a motorised gripper on the VR controller (Zeng et al., 2025). RAPID uses one device for both the handheld and the robot role (Yin et al., 2026)." source="Zeng et al., 2025, arXiv:2510.01607; Yin et al., 2026, arXiv:2602.06653" status="" link="https://arxiv.org/abs/2510.01607" id="n6">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2025.1" y="341" width="247.9" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Gripper signal" tooltip="" detail="" source="" status="" id="n7">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="1772" y="439" width="157.9" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Command + position + torque" tooltip="Commanded position, measured position and torque estimate at 500 Hz in Unitree&#39;s gripper service (the product page states 1000 Hz). No force sensor; grip force only from the torque estimate after calibration.&#xa;&#xa;Source: Unitree dex1_1_service; Unitree product page" detail="Commanded position, measured position and torque estimate at 500 Hz in Unitree&#39;s gripper service (the product page states 1000 Hz). No force sensor; grip force only from the torque estimate after calibration." source="Unitree dex1_1_service; Unitree product page" status="" link="https://github.com/unitreerobotics/dex1_1_service" id="n8">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2025.1" y="418" width="243" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Angle → width curve" tooltip="Position is reported as a motor angle, and Unitree&#39;s code uses two scales (5.62 rad and 5.4 rad over the stroke). The curve is measured on the delivered gripper.&#xa;&#xa;Source: Unitree dex1_1_service; Unitree xr_teleoperate" detail="Position is reported as a motor angle, and Unitree&#39;s code uses two scales (5.62 rad and 5.4 rad over the stroke). The curve is measured on the delivered gripper." source="Unitree dex1_1_service; Unitree xr_teleoperate" status="open" link="https://github.com/unitreerobotics/xr_teleoperate" id="n9">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" parent="1" vertex="1">
            <mxGeometry x="2025.1" y="467" width="178.1" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Mass and tether" tooltip="" detail="" source="" status="" id="n10">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="1772" y="640" width="171.4" height="39" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div&gt;Gripper 550 g + printed adapter 64 g&lt;/div&gt;&lt;div&gt;+ grip sleeve 32 g + controller ≈ 201 g&lt;/div&gt;&lt;div&gt;≈ 846 g (without cables)&lt;/div&gt;" tooltip="550 g gripper (product page) + 64 g adapter + 32 g sleeve (CAD estimates, PETG, 100 % infill) + ≈ 201 g controller (155 g retailer listing plus batteries, estimated). Not weighed. For scale: UMI 780 g (Chi et al., 2024), UMI-3D 1120 g (Wang, 2026).&#xa;&#xa;Source: Unitree product page; VR Expert listing; arXiv:2402.10329; arXiv:2604.14089" detail="550 g gripper (product page) + 64 g adapter + 32 g sleeve (CAD estimates, PETG, 100 % infill) + ≈ 201 g controller (155 g retailer listing plus batteries, estimated). Not weighed. For scale: UMI 780 g (Chi et al., 2024), UMI-3D 1120 g (Wang, 2026)." source="Unitree product page; VR Expert listing; arXiv:2402.10329; arXiv:2604.14089" status="unverified" link="https://unitree.com/Dex1-1" id="n11">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2016.3999999999999" y="530" width="389.2" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Power: 24–64 V, 3.5 A peak" tooltip="24–64 V DC, 0.03 A static, 3.5 A peak (≈ 84 W at 24 V, computed). No supply in the box. Grip force 5–120 N; not commanded as a force: the recording PC sends a target position and a stiffness, and the gripper&#39;s built-in motor controller pushes harder the further an object keeps the fingers from the target.&#xa;&#xa;Source: Unitree product page; Unitree dex1_1_service" detail="24–64 V DC, 0.03 A static, 3.5 A peak (≈ 84 W at 24 V, computed). No supply in the box. Grip force 5–120 N; not commanded as a force: the recording PC sends a target position and a stiffness, and the gripper&#39;s built-in motor controller pushes harder the further an object keeps the fingers from the target." source="Unitree product page; Unitree dex1_1_service" status="" link="https://unitree.com/Dex1-1" id="n12">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2028.4" y="639" width="220" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Camera USB + power/RS-485 cable (extension may be needed)" tooltip="Cables to the handheld: camera USB plus one cable carrying power and RS-485. Cables are listed in the box; their length is not stated.&#xa;&#xa;Source: Unitree developer docs" detail="Cables to the handheld: camera USB plus one cable carrying power and RS-485. Cables are listed in the box; their length is not stated." source="Unitree developer docs" status="" link="https://support.unitree.com/home/en/dex1-1_gripper/about_dex1_1" id="n13">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="2028.4" y="712" width="257" height="66" as="geometry" />
          </mxCell>
        </UserObject>
