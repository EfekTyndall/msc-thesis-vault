        <UserObject label="Switch if the check fails" tooltip="Proposed decision rule: real Dex1-1 if the communication and power check passes, otherwise the printed copy.&#xa;&#xa;Source: Accompanying brief" detail="Proposed decision rule: real Dex1-1 if the communication and power check passes, otherwise the printed copy." source="Accompanying brief" status="" id="n25">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
