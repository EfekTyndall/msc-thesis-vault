        </UserObject>
        <UserObject label="Rack-and-pinion (Dex1-1 principle)" tooltip="Each finger is fixed to a rack (a straight toothed bar); both racks mesh with one central pinion (a small gear) from opposite sides. When the pinion turns, the racks move the same distance in opposite directions, so the fingers close or open together and stay centred. Each rack runs on a miniature linear rail. Layout from Unitree&#39;s official CAD model.&#xa;&#xa;Source: Unitree developer docs (CAD model)" detail="Each finger is fixed to a rack (a straight toothed bar); both racks mesh with one central pinion (a small gear) from opposite sides. When the pinion turns, the racks move the same distance in opposite directions, so the fingers close or open together and stay centred. Each rack runs on a miniature linear rail. Layout from Unitree&#39;s official CAD model." source="Unitree developer docs (CAD model)" status="" link="https://support.unitree.com/home/en/dex1-1_gripper/about_dex1_1" id="n28">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="120.80000000000001" y="130" width="264.3" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Trigger pushes one finger" tooltip="No motor: a trigger in the grip pushes one finger, and the pinion makes the other finger follow by the same amount.&#xa;&#xa;Source: Accompanying brief" detail="No motor: a trigger in the grip pushes one finger, and the pinion makes the other finger follow by the same amount." source="Accompanying brief" status="" id="n29">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="156.6" y="174" width="228.5" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Precedent: UMI, RDT2" tooltip="UMI (Chi et al., 2024) and RDT2 (Liu et al., 2026) use a printed copy of the robot gripper.&#xa;&#xa;Source: Chi et al., 2024, arXiv:2402.10329; Liu et al., 2026, arXiv:2602.03310" detail="UMI (Chi et al., 2024) and RDT2 (Liu et al., 2026) use a printed copy of the robot gripper." source="Chi et al., 2024, arXiv:2402.10329; Liu et al., 2026, arXiv:2602.03310" status="" link="https://arxiv.org/abs/2402.10329" id="n30">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef6c2f;strokeColor=#ef6c2f;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
