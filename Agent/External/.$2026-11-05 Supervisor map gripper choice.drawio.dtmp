          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
            <mxGeometry x="1724.9" y="980" width="96.3" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Concept check on one gripper" tooltip="On one delivered gripper: trigger reading, commands and command rate, gripper signal, power supply, communication, cable and handling with the tether. If it fails, the printed copy is built. Data collection and deployment are planned after it passes.&#xa;&#xa;Source: Accompanying brief" detail="On one delivered gripper: trigger reading, commands and command rate, gripper signal, power supply, communication, cable and handling with the tether. If it fails, the printed copy is built. Data collection and deployment are planned after it passes." source="Accompanying brief" status="open" id="n19">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" parent="1" vertex="1">
            <mxGeometry x="1898" y="972" width="147.8" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Proportional vs open/close trigger" tooltip="Both mappings are tested on the gripper, together with the PICO trigger readout through XRoboToolkit and the trigger-to-finger latency.&#xa;&#xa;Source: Zhao et al., 2025, arXiv:2508.00097" detail="Both mappings are tested on the gripper, together with the PICO trigger readout through XRoboToolkit and the trigger-to-finger latency." source="Zhao et al., 2025, arXiv:2508.00097" status="open" link="https://arxiv.org/abs/2508.00097" id="n20">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" parent="1" vertex="1">
            <mxGeometry x="1898" y="1016" width="252" height="34" as="geometry" />
          </mxCell>
