        <UserObject label="Cable clip" tooltip="The cable clip depends on where the cables leave the gripper; known only after delivery.&#xa;&#xa;Source: CAD design" detail="The cable clip depends on where the cables leave the gripper; known only after delivery." source="CAD design" status="open" link="https://www.universal-robots.com/manuals/latest/en/datasheets/ur10e/" id="n21">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2fb8a3;fontColor=#1f2a37;fontFamily=Helvetica;fontStyle=1;fontSize=13;dashed=1;dashPattern=5 4;strokeWidth=2;" parent="1" vertex="1">
            <mxGeometry x="1898" y="1060" width="255.4" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Recommendation" tooltip="Real Dex1-1 as the main line; printed copy kept as a fallback at concept level. For discussion.&#xa;&#xa;Source: Accompanying brief" detail="Real Dex1-1 as the main line; printed copy kept as a fallback at concept level. For discussion." source="Accompanying brief" status="" id="n22">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=15;" parent="1" vertex="1">
            <mxGeometry x="1440" y="1163" width="205" height="42" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Main Path: Real Dex1-1" tooltip="Work before delivery goes into the real path: dummy-gripper print and software.&#xa;&#xa;Source: Project plan" detail="Work before delivery goes into the real path: dummy-gripper print and software." source="Project plan" status="" id="n23">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#7a63d6;strokeColor=#7a63d6;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
