        <UserObject label="Software against a simulated gripper" tooltip="The trigger-to-gripper software is developed against a simulated gripper, so it is ready on delivery.&#xa;&#xa;Source: Project plan" detail="The trigger-to-gripper software is developed against a simulated gripper, so it is ready on delivery." source="Project plan" status="" id="n16">
          <mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2fb8a3;strokeColor=#2fb8a3;fontColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=13;" parent="1" vertex="1">
